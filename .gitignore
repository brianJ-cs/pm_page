# 本機備份與草稿。留在硬碟上，不進版本控制 —— git 的歷史本身就是備份，
# 再把 .bak 一起存進來，等於同一份東西留兩套，日後不知道哪一套才算數。
backup/
turn/
*.bak.html
*.bak2.html
design_and_PM no declutter.html

# 抓給對話看的畫面，不是專案的一部分
bug*.png
.claude/skills/*/out/

# 測試跑出來的畫面截圖（driver.mjs --shot）
out/

# Netlify 的發佈資料夾，build-single.mjs 產的 —— 正本是根目錄那幾支
public/

# logo_page 併進來之後留下的：它本來是獨立的一站，在自己的資料夾跑
# `netlify dev` 就會再長出這個本機快取
logo_page/.netlify/

# 合成單檔也是產出來的（node build-single.mjs --bundle），只有要寄一個檔案給
# 別人的時候才生。進了版控就會有人拿到過期的那一份 —— 要用再生一次就好。
dm-editor-single.html

# 手動備份的資料夾，還有隨手截的圖 —— 歷史本身就是備份
backup0722/
新增資料夾/
words*.png

# 舊東西全部收在這裡。整個資料夾都不進版控 —— 歷史本身就是備份
clutter/

# 從系統下載出來的落版單（是資料，不是程式）
timelines/

# Local Netlify folder
.netlify
